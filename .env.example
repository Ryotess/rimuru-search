# Copy this file to .env. Every value below is optional; these are the bundled defaults.

# -----------------------------------------------------------------------------
# Ports exposed by Docker Compose
# -----------------------------------------------------------------------------
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
SOURCE_API_PORT=3000
EMBEDDING_PORT=5678
RERANKER_PORT=5679

# -----------------------------------------------------------------------------
# PostgreSQL
# Keep GLOBAL_DATABASE_URL aligned with the PGSQL_* values for native commands.
# Compose constructs its internal URL from PGSQL_* automatically.
# -----------------------------------------------------------------------------
PGSQL_DB=hybrid_search
PGSQL_USER=hybrid_search
PGSQL_PASSWORD=local_dev_password  # pragma: allowlist secret
GLOBAL_DATABASE_URL=postgresql://hybrid_search:local_dev_password@localhost:5432/hybrid_search  # pragma: allowlist secret
GLOBAL_HNSW_EF_SEARCH=200
GLOBAL_HNSW_ITERATIVE_SCAN=strict_order
GLOBAL_DB_POOL_SIZE=5
GLOBAL_DB_MAX_OVERFLOW=10
GLOBAL_DB_POOL_TIMEOUT=30
GLOBAL_DB_POOL_RECYCLE=1800
DOCUMENT_DEFAULT_COLLECTION=default
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

# -----------------------------------------------------------------------------
# Embedding and reranking models
# VDB_EMBEDDING_DIM must stay 1024 with the bundled database migration.
# Set SEARCH_ENABLE_RERANK=false when you only want embedding + RRF retrieval.
# *_MODEL_ID controls both the bundled vLLM model and the model requested by the
# application. Request-model overrides are only needed for an external served alias.
# -----------------------------------------------------------------------------
VLLM_IMAGE=vllm/vllm-openai-cpu:v0.28.0
EMBEDDING_MODEL_ID=mixedbread-ai/mxbai-embed-large-v1
RERANKER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L6-v2
# Leave custom model code disabled unless you reviewed and trust its repository.
RERANKER_REMOTE_CODE_FLAG=--no-trust-remote-code
EMBEDDING_MAX_MODEL_LEN=512
EMBEDDING_MAX_NUM_SEQS=16
RERANKER_MAX_MODEL_LEN=512
RERANKER_MAX_NUM_SEQS=16
EMBED_HOSTED_VLLM_API_BASE=http://localhost:5678/v1
RERANKER_HOSTED_VLLM_API_BASE=http://localhost:5679/v1
RERANKER_TOP_N=10
RERANKER_MAX_DOCUMENT_LENGTH=8192
VDB_EMBEDDING_DIM=1024
SEARCH_ENABLE_RERANK=true

# The API container uses Docker-internal services by default. Uncomment these to
# use another OpenAI-compatible endpoint from inside the container. A service on
# the host is usually reached as http://host.docker.internal:<port>/v1.
# COMPOSE_EMBED_API_BASE=http://host.docker.internal:5678/v1
# COMPOSE_EMBED_REQUEST_MODEL=hosted_vllm/custom-served-embedding
# COMPOSE_RERANKER_API_BASE=http://host.docker.internal:5679/v1
# COMPOSE_RERANKER_REQUEST_MODEL=hosted_vllm/custom-served-reranker

# Native-only request-model aliases for an endpoint whose /v1/models ID differs
# from *_MODEL_ID. Most users should leave these unset.
# EMBEDDING_REQUEST_MODEL=hosted_vllm/custom-served-embedding
# RERANKER_REQUEST_MODEL=hosted_vllm/custom-served-reranker

# -----------------------------------------------------------------------------
# Default behavior for POST /v1/search
# Request fields can still override these values per call.
# The lexical backend is an operator choice and is not exposed as an API field.
# -----------------------------------------------------------------------------
SEARCH_LEXICAL_BACKEND=bm25
SEARCH_VECTOR_TOP_K_DEFAULT=100
SEARCH_LEXICAL_TOP_K_DEFAULT=100
SEARCH_USE_FUZZY_DEFAULT=false
SEARCH_MIN_SIMILARITY_DEFAULT=0.2
SEARCH_RRF_TOP_K_DEFAULT=15
SEARCH_RERANK_TOP_N_DEFAULT=3
LEXICAL_TOP_K_DEFAULT=10
LEXICAL_TOP_K_MAX=100
LEXICAL_MIN_QUERY_LENGTH=1
LEXICAL_TRGM_MIN_SIMILARITY=0.05
LEXICAL_ENABLE_FUZZY=false

# -----------------------------------------------------------------------------
# Direct JSON / JSONL / CSV import: make import FILE=./documents.jsonl
# Field lists are comma-separated. Empty IMPORT_METADATA_FIELDS keeps every
# unused top-level field as metadata. IMPORT_MODE is upsert or a service-wide
# replace that removes collections absent from the imported snapshot.
# -----------------------------------------------------------------------------
IMPORT_ID_FIELD=id
IMPORT_CONTENT_FIELDS=content
IMPORT_METADATA_FIELDS=
IMPORT_COLLECTION_FIELD=collection
IMPORT_GENERATE_IDS=false
IMPORT_MODE=upsert
IMPORT_FILE_ENCODING=utf-8
IMPORT_CSV_DELIMITER=,

# Shared batching for file import and HTTP-source seeding.
SEED_ROWS_PER_CHUNK=2000
SEED_EMBED_BATCH_SIZE=256
SEED_DB_BATCH_SIZE=2000
SEED_MAX_EMBED_CONCURRENCY=6

# -----------------------------------------------------------------------------
# Paginated HTTP source (advanced ingestion / scheduled snapshot sync)
# Native commands use SOURCE_API_BASE_URL. Containers use the sample source by
# default; set COMPOSE_SOURCE_API_BASE_URL to override it from Compose.
# -----------------------------------------------------------------------------
SOURCE_API_BASE_URL=http://localhost:3000
SOURCE_API_DOCUMENTS_PATH=/v1/documents
# COMPOSE_SOURCE_API_BASE_URL=http://host.docker.internal:3000

# -----------------------------------------------------------------------------
# Redis is optional for native execution. Compose enables its internal Redis by
# default. Set COMPOSE_CACHE_REDIS_URL= (an explicitly empty value) to disable it.
# -----------------------------------------------------------------------------
CACHE_REDIS_URL=
COMPOSE_CACHE_REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600
CACHE_KEY_PREFIX=hybrid-search:search:v2

LOG_LEVEL=INFO
